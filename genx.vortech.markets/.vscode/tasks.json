{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build GenX frontend for SEO and performance",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$eslint-stylish"
			]
		},
		{
			"label": "Lint GenX frontend",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"lint"
			],
			"isBackground": false,
			"problemMatcher": [
				"$eslint-stylish"
			]
		},
		{
			"label": "Run GenX dashboard tests",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"test:dashboard"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run GenX datafeed tests",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"test:datafeed"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Start GenX production preview",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"start"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Start GenX production preview on 3001",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"start",
				"--",
				"-p",
				"3001"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Rebuild GenX after Open Graph fix",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$eslint-stylish"
			]
		},
		{
			"label": "Start refreshed GenX preview on 3002",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"start",
				"--",
				"-p",
				"3002"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Install frontend ESLint tooling",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"install"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Re-run GenX datafeed tests",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"test:datafeed"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Re-run GenX dashboard tests",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"test:dashboard"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Final production build verification",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$eslint-stylish"
			]
		},
		{
			"label": "Measure GenX homepage with Lighthouse",
			"type": "shell",
			"command": "npx",
			"args": [
				"--yes",
				"lighthouse",
				"http://localhost:3002/",
				"--only-categories=performance",
				"--output=json",
				"--output-path=C:\\Users\\Surface Pro\\AppData\\Local\\Temp\\genx-home-lighthouse.json",
				"--chrome-flags=--headless --no-sandbox"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Find pending Lighthouse process",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"Get-CimInstance Win32_Process | Where-Object { $_.CommandLine -like '*lighthouse*' } | Select-Object ProcessId,CommandLine | Format-List"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "List Node process IDs",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"Get-CimInstance Win32_Process | Format-List ProcessId,CommandLine | Out-String | Select-String lighthouse"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Identify Lighthouse process ID",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"Get-CimInstance Win32_Process | Where-Object CommandLine -Match lighthouse | Select-Object ProcessId,Name,CommandLine | Format-List"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run Lighthouse homepage audit",
			"type": "shell",
			"command": "npx",
			"args": [
				"--yes",
				"lighthouse",
				"http://localhost:3002/",
				"--only-categories=performance",
				"--output=json",
				"--output-path=C:\\Users\\Surface Pro\\AppData\\Local\\Temp\\genx-home-lighthouse.json",
				"--chrome-flags=--headless --no-sandbox",
				"--no-enable-error-reporting"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Find GenX preview process IDs",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"Get-NetTCPConnection -State Listen | Where-Object LocalPort -In 3001,3002 | Select-Object LocalPort,OwningProcess"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Restore frontend dependency lock",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"uninstall",
				"--save-dev",
				"eslint",
				"eslint-config-next"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Stop GenX preview servers",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"if (Get-Process -Id 21440 -ErrorAction SilentlyContinue) { Stop-Process -Id 21440 }; if (Get-Process -Id 16356 -ErrorAction SilentlyContinue) { Stop-Process -Id 16356 }"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify restored GenX frontend build",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$eslint-stylish"
			]
		},
		{
			"label": "Verify restored datafeed tests",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"test:datafeed"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Confirm preview servers stopped",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"Get-NetTCPConnection -State Listen | Where-Object LocalPort -In 3001,3002 | Select-Object LocalPort,OwningProcess"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify restored dashboard tests",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"test:dashboard"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build dashboard sidebar animation update",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$eslint-stylish"
			]
		},
		{
			"label": "Verify final sidebar animation build",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$eslint-stylish"
			]
		}
	]
}